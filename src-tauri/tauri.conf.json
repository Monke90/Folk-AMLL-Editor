{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folk AMLL Editor",
  "version": "1.0.0",
  "identifier": "xyz.folk-amll-tool.editor",
  "build": {
    "beforeDevCommand": "pnpm dev-only",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build-only",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Per-syllable lyric editor",
    "longDescription": "Folk AMLL Editor is an open-source per-syllable lyric editor for the AMLL ecosystem.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
