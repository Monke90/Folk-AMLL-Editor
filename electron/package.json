{
  "name": "folk-amll-editor-desktop",
  "productName": "Folk AMLL Editor",
  "version": "1.0.0",
  "description": "Desktop build of Folk AMLL Editor",
  "author": "InternalMonke",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "xyz.folk-amll-tool.editor",
    "productName": "Folk AMLL Editor",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.cjs", "package.json"],
    "extraResources": [{ "from": "../dist", "to": "app" }],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg"], "category": "public.app-category.music" },
    "linux": { "target": ["AppImage"], "category": "AudioVideo" },
    "artifactName": "Folk-AMLL-Editor-${version}-${os}-${arch}.${ext}"
  }
}
